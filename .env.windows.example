APP_NAME=Material Masterdata Portal
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/masterdata
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_SECRET
JWT_EXP_MINUTES=480
CORS_ORIGINS=http://localhost:8088
FRONTEND_URL=http://localhost:8088
BOOTSTRAP_ADMIN_EMAILS=admin@company.com
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
DEV_AUTH_ENABLED=false
EMAIL_NOTIFICATIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@company.com
SMTP_STARTTLS=true
AUTO_IMPORT_ENABLED=true
AUTO_IMPORT_FILE_PATH=C:/MaterialMasterdataData/Danh muc vat tu.xlsx
AUTO_IMPORT_HOUR=19
AUTO_IMPORT_MINUTE=0
AUTO_IMPORT_TIMEZONE=Asia/Ho_Chi_Minh
RUN_BACKGROUND_JOBS=false
INIT_DB_ON_STARTUP=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_RECYCLE_SECONDS=300
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
